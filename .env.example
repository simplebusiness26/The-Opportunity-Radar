# ---------------------------------------------------------------------------
# Opportunity Radar — environment template
# Copy to `.env` and adjust. Nothing here is required for MANUAL mode except
# DATABASE_URL and RADAR_SECRET_KEY, both of which have working local defaults
# created by `npm run db:up` / `scripts/gen-key.ts`.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Local development points at the embedded PGlite wire server (`npm run db:up`).
# Production points at any PostgreSQL 14+ instance.
DATABASE_URL=postgres://radar:radar@127.0.0.1:5433/postgres

# 32-byte key, base64. Encrypts stored provider credentials (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RADAR_SECRET_KEY=

# Public origin, used for cookie/CSRF origin checks and absolute links.
RADAR_PUBLIC_URL=http://localhost:3000

# --- Access control --------------------------------------------------------
# When true, only the first account may be created; further sign-ups are refused.
RADAR_SINGLE_OWNER=true

# --- Background work -------------------------------------------------------
# Bearer token for POST /api/v1/system/tick. Leave blank to disable the endpoint
# (the long-running worker still works). Generate like RADAR_SECRET_KEY.
RADAR_TICK_TOKEN=
RADAR_WORKER_CONCURRENCY=2

# --- Operating System bridge ----------------------------------------------
# Dedicated bearer token for POST /api/v1/integrations/operating-system/sync.
# Leave blank to disable the endpoint. Use a different value from every other token.
RADAR_OS_SYNC_TOKEN=
# Optional in a single-workspace install. Required once Radar has multiple workspaces.
# RADAR_OS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- Execution boundary ----------------------------------------------------
# Bearer token for POST /api/v1/execution/feedback, which is how whoever built
# a handed-off opportunity reports what actually happened. Leave blank to
# disable the endpoint; outcomes can still be recorded in the interface.
# Deliberately separate from RADAR_TICK_TOKEN: they go to different parties.
RADAR_FEEDBACK_TOKEN=

# --- Determinism (tests only) ----------------------------------------------
# RADAR_CLOCK=fixed:2026-08-18T00:00:00Z

# --- AI providers (optional; absent = MANUAL mode) -------------------------
# Credentials are normally entered in Settings -> AI Providers and stored
# encrypted in the database. These variables exist for headless deployments.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Source credentials (optional) ----------------------------------------
# See CONNECTIONS_REQUIRED.md. All adapters run from Settings -> Sources.
# GITHUB_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Deployment tuning ------------------------------------------------------
# Multiplies every rate limit. Raise it when many legitimate users share one
# apparent address (corporate NAT, an untrusted proxy). Never lower it in
# production without reading docs/SECURITY.md.
RADAR_RATE_LIMIT_SCALE=1

# Enable ONLY when Radar sits behind a proxy that overwrites x-forwarded-for.
# With this off, Radar ignores the header entirely, so nobody can forge an
# address to escape rate limiting.
RADAR_TRUST_PROXY=false
